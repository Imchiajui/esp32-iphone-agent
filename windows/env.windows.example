# Windows + 傳統 ESP32（藍牙滑鼠，USB 序列線）用的設定。由 setup.bat 複製成 server\.env。
# 值有空白就用引號；路徑請用正斜線（C:/...）或保持原樣。

# --- 視覺模型（任何 OpenAI 相容、能吃圖片的 API）---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_EXTRA_BODY='{}'
# Gemini 的 OpenAI 相容端點：LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 想分開設定：ACTOR_MODEL=...（每一步選動作，越快越好）PLANNER_MODEL=...（寫計畫）

# --- 板子：COM5 這類名稱，或 auto 自動找 CP2102/CH340 ---
SERIAL_PORT=auto

# --- AirPlay 接收（iPhone 控制中心 → 螢幕鏡像輸出 會看到這個名字）---
AIRPLAY_NAME='iPhone Agent'
# UXPLAY=C:/path/to/uxplay.exe    # 不設就用專案資料夾裡的 uxplay-win64

HOST=127.0.0.1
PORT=8890
HIDAGENT_DEBUG=0
